{
  "info": {
    "name": "MemoBook (local)",
    "description": "MemoBook backend API against a local server. Start the backend with `npm run dev`, then run the folders top to bottom: \"Create contact\" stores {{contactId}}, \"Add social\" stores {{socialId}}, \"Add custom field\" stores {{fieldId}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "contactId",
      "value": "01"
    },
    {
      "key": "socialId",
      "value": ""
    },
    {
      "key": "fieldId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Contacts",
      "item": [
        {
          "name": "List contacts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contacts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contacts"
              ]
            }
          }
        },
        {
          "name": "Get seeded contact (Harold)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contacts/01",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contacts",
                "01"
              ]
            }
          }
        },
        {
          "name": "Create contact",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"contactId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Met at the pottery class, makes the best chai.\",\n  \"firstName\": \"Priya\",\n  \"lastName\": \"Patel\",\n  \"relation\": \"Friend\",\n  \"phone\": \"+1 (555) 321-0000\",\n  \"email\": \"priya.p@email.com\",\n  \"city\": \"Chicago\",\n  \"country\": \"United States\",\n  \"socials\": [\n    {\n      \"platform\": \"instagram\",\n      \"handle\": \"@priyapots\",\n      \"url\": \"https://instagram.com/priyapots\"\n    },\n    {\n      \"platform\": \"other\",\n      \"label\": \"Etsy\",\n      \"handle\": \"PriyaPottery\",\n      \"url\": \"https://etsy.com/shop/PriyaPottery\"\n    }\n  ],\n  \"customFields\": [\n    {\n      \"section\": \"personal\",\n      \"label\": \"Birthday\",\n      \"value\": \"June 2\"\n    },\n    {\n      \"section\": \"address\",\n      \"label\": \"Buzzer\",\n      \"value\": \"#12\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/contacts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contacts"
              ]
            }
          }
        },
        {
          "name": "Get created contact",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contacts/{{contactId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contacts",
                "{{contactId}}"
              ]
            }
          }
        },
        {
          "name": "Update contact (partial)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lastName\": \"Patel-Singh\",\n  \"phone\": \"+1 (555) 999-1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/contacts/{{contactId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contacts",
                "{{contactId}}"
              ]
            },
            "description": "Only the fields sent are changed. name is rebuilt from firstName + lastName. Each change is logged on the timeline."
          }
        },
        {
          "name": "Create contact without firstName (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lastName\": \"NoFirstName\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/contacts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contacts"
              ]
            }
          }
        },
        {
          "name": "Get unknown contact (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
